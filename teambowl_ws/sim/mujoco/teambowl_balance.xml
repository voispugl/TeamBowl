<mujoco model="bowl">
  <compiler angle="radian"/>

  <!-- ================================================================
       Physics settings
       timestep=0.002 → 500 Hz physics (inner loop runs every 3-4 steps)
       RK4 integrator for accuracy with stiff contacts
  ================================================================ -->
  <option integrator="RK4" timestep="0.002" gravity="0 0 -9.81"/>

  <!-- ================================================================
       Contact / friction defaults
       "wheel" class applied to the cylinder collision geoms on both wheels.
       friction="sliding torsional rolling"
       solref="time_constant damping_ratio"
       solimp="d0 d1 width midpoint power"
  ================================================================ -->
  <default>
    <default class="wheel">
      <geom friction="1.2 0.005 0.0001"
            solref="0.02 1"
            solimp="0.9 0.95 0.001 0.5 2"/>
    </default>
  </default>

  <asset>
    <mesh name="mesh59"  file="meshes/59.stl"/>
    <mesh name="mesh63"  file="meshes/63.stl"/>
    <mesh name="mesh75"  file="meshes/75.stl"/>
    <mesh name="mesh79"  file="meshes/79.stl"/>
    <mesh name="mesh83"  file="meshes/83.stl"/>
    <mesh name="mesh87"  file="meshes/87.stl"/>
    <mesh name="mesh100" file="meshes/100.stl"/>
    <mesh name="mesh104" file="meshes/104.stl"/>
    <mesh name="mesh111" file="meshes/111.stl"/>
    <mesh name="mesh127" file="meshes/127.stl"/>
    <mesh name="mesh131" file="meshes/131.stl"/>
    <mesh name="mesh150" file="meshes/150.stl"/>
  </asset>

  <worldbody>
    <!-- ============================================================
         Floor — friction matched to wheel defaults
    ============================================================ -->
    <geom name="floor" size="0 0 0.01" pos="0 0 -0.3" type="plane"
          rgba="1.0 1.0 1.0 1"
          friction="1.0 0.005 0.0001"
          solref="0.02 1"
          solimp="0.9 0.95 0.001 0.5 2"/>

    <!-- ============================================================
         Global-frame anchor site (world origin, no body needed).
         The framepos/framequat/framelinvel/frameangvel sensors below
         report the Frame body's exact pose in this world frame —
         this is the "perfect EKF / ground-truth IMU" output used by
         the sim to validate the complementary filter.
    ============================================================ -->
    <site name="world_origin" pos="0 0 0"/>

    <!-- ============================================================
         Main robot body
    ============================================================ -->
    <body name="Frame">
      <inertial pos="-0.00577203 0.0294079 0.0402019"
                quat="0.438736 0.553719 0.442563 0.552307"
                mass="13"
                diaginertia="0.573956 0.486537 0.334122"/>
      <joint name="Fastened 1_0" type="free"/>

      <!-- Body-frame IMU site (used for complementary filter) -->
      <site name="imu_sensor_site" pos="0 0 0.05"/>

      <geom type="mesh" contype="0" conaffinity="0" mesh="mesh111"
            pos="-0.00546297 0.0848 0.0954208"/>
      <geom type="box" size="0.25 0.15 0.22" pos="0 0.05 0.1"
            contype="1" conaffinity="1" rgba="0 0 0 0"/>

      <!-- == Right hip / leg assembly == -->
      <body name="Hip" pos="0.144537 -0.03389 -0.118135">
        <inertial pos="9.89938e-11 -0.0652752 -3.6294e-07"
                  quat="2.99052e-05 0.703737 2.96222e-05 0.71046"
                  mass="4.677" diaginertia="0.0203952 0.0192001 0.00962716"/>
        <geom type="mesh" contype="0" conaffinity="0" mesh="mesh59"
              pos="0.15 0.11869 0.213556"/>
        <body name="Thigh" pos="-0.03125 -0.07 0" quat="0.976296 -0.216439 0 0">
          <inertial pos="0.0235362 -0.120388 0.101442"
                    quat="0.636039 0.308271 -0.288111 0.646076"
                    mass="0.439" diaginertia="0.00607694 0.00604218 0.000157761"/>
          <geom type="mesh" contype="0" conaffinity="0" mesh="mesh79"
                pos="0.18125 0.18869 0.213556"/>
          <body name="Calf" pos="0.02625 -0.225522 0.190669" quat="0.984808 -0.173648 0 0">
            <inertial pos="0.00130628 0.0508335 -0.148234"
                      quat="0.697745 0.11292 -0.120002 0.697137"
                      mass="0.804" diaginertia="0.0145063 0.0144449 0.000354461"/>
            <geom type="mesh" contype="0" conaffinity="0" mesh="mesh131"
                  pos="0.155 0.414212 0.0228866"/>
            <body name="Foot" pos="0.02725 0.0957158 -0.279381" quat="0.953717 0.300706 0 0">
              <inertial pos="-0.0257628 0.0025349 -0.0233876"
                        quat="0.464535 0.517605 -0.534755 0.479927"
                        mass="0.242" diaginertia="0.000515045 0.000386185 0.000183729"/>
              <geom type="mesh" contype="1" conaffinity="1" mesh="mesh127"
                    pos="0.12775 0.318497 0.302267"
                    friction="0.8 0.005 0.0001" solref="0.02 1" solimp="0.9 0.95 0.001 0.5 2"/>
            </body>
          </body>
        </body>
        <body name="Knee Kicker_1" pos="0.03125 -0.07 0" quat="0.92388 -0.382683 0 0">
          <inertial pos="-0.0160967 -0.0110483 0.0322497"
                    quat="0.979198 0.163089 -0.119078 -0.0198329"
                    mass="0.178" diaginertia="0.000242067 0.000232993 3.88114e-05"/>
          <geom type="mesh" contype="0" conaffinity="0" mesh="mesh87"
                pos="0.11875 0.18869 0.213556"/>
          <body name="Align bar" pos="-0.03625 -0.0225108 0.0657059" quat="0.984808 0.173648 0 0">
            <inertial pos="-2.02172e-12 -0.138854 0.117827"
                      quat="0.641754 0.296903 -0.296903 0.641754"
                      mass="0.186" diaginertia="0.00239967 0.00239678 2.56216e-05"/>
            <geom type="mesh" contype="0" conaffinity="0" mesh="mesh83"
                  pos="0.155 0.211201 0.14785"/>
          </body>
        </body>
      </body>

      <!-- == Left hip / leg assembly == -->
      <body name="Hip_1" pos="-0.155463 -0.03389 -0.118135">
        <inertial pos="9.89938e-11 -0.0652752 -3.6294e-07"
                  quat="2.99052e-05 0.703737 2.96222e-05 0.71046"
                  mass="4.677" diaginertia="0.0203952 0.0192001 0.00962716"/>
        <geom type="mesh" contype="0" conaffinity="0" mesh="mesh59"
              pos="0.15 0.11869 0.213556"/>
        <body name="Thigh_1" pos="-0.03125 -0.07 0" quat="0.976296 -0.216439 0 0">
          <inertial pos="0.0235362 -0.120388 0.101442"
                    quat="0.636039 0.308271 -0.288111 0.646076"
                    mass="0.439" diaginertia="0.00607694 0.00604218 0.000157761"/>
          <geom type="mesh" contype="0" conaffinity="0" mesh="mesh79"
                pos="0.18125 0.18869 0.213556"/>
          <body name="Calf_1" pos="0.02625 -0.225522 0.190669" quat="0.984808 -0.173648 0 0">
            <inertial pos="0.00130628 0.0508335 -0.148234"
                      quat="0.697745 0.11292 -0.120002 0.697137"
                      mass="0.804" diaginertia="0.0145063 0.0144449 0.000354461"/>
            <geom type="mesh" contype="0" conaffinity="0" mesh="mesh131"
                  pos="0.155 0.414212 0.0228866"/>
            <body name="Foot_1" pos="0.02725 0.0957158 -0.279381" quat="0.953717 0.300706 0 0">
              <inertial pos="-0.0257628 0.0025349 -0.0233876"
                        quat="0.464535 0.517605 -0.534755 0.479927"
                        mass="0.242" diaginertia="0.000515045 0.000386185 0.000183729"/>
              <geom type="mesh" contype="1" conaffinity="1" mesh="mesh127"
                    pos="0.12775 0.318497 0.302267"
                    friction="0.8 0.005 0.0001" solref="0.02 1" solimp="0.9 0.95 0.001 0.5 2"/>
            </body>
          </body>
        </body>
        <body name="Knee Kicker" pos="0.03125 -0.07 0" quat="0.92388 -0.382683 0 0">
          <inertial pos="-0.0160967 -0.0110483 0.0322497"
                    quat="0.979198 0.163089 -0.119078 -0.0198329"
                    mass="0.178" diaginertia="0.000242067 0.000232993 3.88114e-05"/>
          <geom type="mesh" contype="0" conaffinity="0" mesh="mesh87"
                pos="0.11875 0.18869 0.213556"/>
          <body name="Align bar_1" pos="-0.03625 -0.0225108 0.0657059" quat="0.984808 0.173648 0 0">
            <inertial pos="-2.02172e-12 -0.138854 0.117827"
                      quat="0.641754 0.296903 -0.296903 0.641754"
                      mass="0.186" diaginertia="0.00239967 0.00239678 2.56216e-05"/>
            <geom type="mesh" contype="0" conaffinity="0" mesh="mesh83"
                  pos="0.155 0.211201 0.14785"/>
          </body>
        </body>
      </body>

      <!-- == Left wheel gear + wheel == -->
      <body name="Wheel Gear_1" pos="-0.282193 0.0390428 0.0543905"
            quat="0.707105 -0.707108 0 0">
        <inertial pos="0 2.72439e-07 -2.20681e-05"
                  quat="-0.00435929 0.707093 -0.00435929 0.707093"
                  mass="0.046" diaginertia="3.58168e-06 3.57739e-06 2.96111e-06"/>
        <joint name="left_motor_0" pos="0 0 0" axis="-1 0 0"/>
        <geom type="mesh" contype="0" conaffinity="0" mesh="mesh100"
              pos="0.27443 0.0457572 0.0410302"/>
      </body>

      <body name="Wheel_1" pos="-0.302263 -0.03839 -0.056195">
        <inertial pos="0.00423538 7.2923e-09 -1.13899e-10"
                  mass="0.707" diaginertia="0.00916228 0.00465503 0.00465503"/>
        <joint name="left_wheel_0" pos="0 0 0" axis="-1 0 0"/>
        <geom type="mesh" contype="0" conaffinity="0" mesh="mesh150"
              pos="0.2968 0.12319 0.151616"/>
        <!-- Collision cylinder: class="wheel" picks up friction defaults -->
        <geom class="wheel" type="cylinder" size="0.154 0.018"
              quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="0.2 0.2 0.2 0.6"/>
      </body>

      <!-- == Lid + lid gear (passive, no actuator) == -->
      <body name="Lid" pos="-0.00546297 -0.11133 0.294511">
        <inertial pos="-0.00667876 0.103152 -0.00905696"
                  quat="-0.00956325 0.706186 0.0361322 0.70704"
                  mass="2.818" diaginertia="0.0965965 0.0585789 0.040202"/>
        <geom type="mesh" contype="0" conaffinity="0" mesh="mesh104"
              pos="0 0.19613 -0.20009"/>
      </body>

      <body name="Lid Gear" pos="-0.00560326 -0.163819 0.240861">
        <inertial pos="1.04235e-12 2.50691e-11 0.0144022"
                  quat="0.5 0.5 -0.5 0.5"
                  mass="0.025" diaginertia="3.67541e-06 3.37396e-06 3.37396e-06"/>
        <geom type="mesh" contype="0" conaffinity="0" mesh="mesh63"
              pos="0.000140291 0.248619 -0.14544"/>
      </body>

      <!-- == Right wheel gear + wheel == -->
      <body name="Wheel Gear" pos="0.271267 0.0390428 0.0543905">
        <inertial pos="0 2.72439e-07 -2.20681e-05"
                  quat="-0.00435929 0.707093 -0.00435929 0.707093"
                  mass="0.046" diaginertia="3.58168e-06 3.57739e-06 2.96111e-06"/>
        <joint name="right_motor_0" pos="0 0 0" axis="1 0 0"/>
        <geom type="mesh" contype="0" conaffinity="0" mesh="mesh100"
              pos="0.27443 0.0457572 0.0410302"/>
      </body>

      <body name="Wheel" pos="0.26638 -0.03839 -0.056195"
            quat="1.76039e-12 1.32679e-06 -1 -1.32679e-06">
        <inertial pos="-0.0207221 7.2923e-09 -1.13899e-10"
                  mass="0.707" diaginertia="0.00916228 0.00465503 0.00465503"/>
        <joint name="right_wheel_0" pos="0 0 0" axis="-1 0 0"/>
        <geom type="mesh" contype="0" conaffinity="0" mesh="mesh150"
              pos="0.271842 0.12319 0.151616"/>
        <!-- Collision cylinder: class="wheel" picks up friction defaults -->
        <geom class="wheel" type="cylinder" size="0.154 0.018"
              quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="0.2 0.2 0.2 0.6"/>
      </body>

    </body>
  </worldbody>

  <!-- ================================================================
       Actuators — motor type: ctrl input is torque in Newton-metres.
       ctrlrange="-30 30" Nm per wheel. Adjust after first test run.
       (Was: velocity actuators with kv=1.)
  ================================================================ -->
  <actuator>
    <motor name="act_left_wheel"  joint="left_wheel_0"  ctrlrange="-30 30" gear="1"/>
    <motor name="act_right_wheel" joint="right_wheel_0" ctrlrange="-30 30" gear="1"/>
  </actuator>

  <!-- ================================================================
       Sensors

       Body-frame IMU (at imu_sensor_site, moves with robot):
         imu_gyro      — angular velocity [wx, wy, wz] in body frame
         imu_accel     — linear acceleration [ax, ay, az] in body frame
         imu_lin_vel   — linear velocity of the IMU site in body frame

       Global-frame ground-truth ("perfect EKF"):
         gt_pos        — Frame body world position [x, y, z]
         gt_quat       — Frame body world orientation [w, x, y, z]
         gt_linvel     — Frame body world linear velocity [vx, vy, vz]
         gt_angvel     — Frame body world angular velocity [wx, wy, wz]

       NOTE: gt_* sensors give exact world-frame state — use these in
       sim.py to validate the complementary filter pitch estimate.
  ================================================================ -->
  <sensor>
    <!-- Body-frame IMU -->
    <gyro         site="imu_sensor_site" name="imu_gyro"/>
    <accelerometer site="imu_sensor_site" name="imu_accel"/>
    <velocimeter  site="imu_sensor_site" name="imu_lin_vel"/>

    <!-- Global-frame ground-truth sensors -->
    <framepos    name="gt_pos"    objtype="body" objname="Frame"/>
    <framequat   name="gt_quat"   objtype="body" objname="Frame"/>
    <framelinvel name="gt_linvel" objtype="body" objname="Frame"/>
    <frameangvel name="gt_angvel" objtype="body" objname="Frame"/>
  </sensor>

</mujoco>
