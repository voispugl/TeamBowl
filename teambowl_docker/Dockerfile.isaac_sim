FROM nvcr.io/nvidia/isaac-sim:4.2.0

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# Locale setup — required before adding the ROS2 apt repo
RUN apt-get update && apt-get install -y locales && \
    locale-gen en_US en_US.UTF-8 && \
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 && \
    rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8

# Add ROS2 Humble apt repository
RUN apt-get update && apt-get install -y software-properties-common curl git && \
    add-apt-repository universe && \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
         -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
         http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
         | tee /etc/apt/sources.list.d/ros2.list > /dev/null && \
    rm -rf /var/lib/apt/lists/*

# ROS2 Humble + tools needed by robot workspace packages
# NOTE: libopencv-dev omitted — Isaac Sim ships its own OpenCV build.
RUN apt-get update && apt-get install -y \
    ros-humble-ros-base \
    ros-humble-navigation2 \
    ros-humble-nav2-bringup \
    ros-humble-robot-localization \
    ros-humble-tf2 \
    ros-humble-tf2-ros \
    ros-humble-tf2-geometry-msgs \
    ros-humble-cv-bridge \
    ros-humble-image-transport \
    ros-humble-image-transport-plugins \
    ros-humble-image-pipeline \
    ros-humble-vision-msgs \
    ros-humble-foxglove-bridge \
    ros-humble-twist-mux \
    ros-humble-robot-state-publisher \
    ros-humble-joint-state-publisher \
    ros-humble-xacro \
    ros-humble-diagnostic-updater \
    ros-humble-diagnostic-msgs \
    ros-humble-message-filters \
    ros-humble-imu-tools \
    ros-humble-pointcloud-to-laserscan \
    ros-humble-mavros-msgs \
    ros-humble-visualization-msgs \
    ros-humble-foxglove-msgs \
    ros-humble-depth-image-proc \
    ros-humble-stereo-msgs \
    libeigen3-dev \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    python3-pip \
    python3-yaml \
    && rm -rf /var/lib/apt/lists/* \
    && rosdep init || true \
    && rosdep update || true

# ── nvblox from Isaac ROS source (x86_64 + CUDA — works on RTX 5080) ─────────
# isaac_ros_visual_slam intentionally omitted: requires Jetson VPI (aarch64 only).
# Ground-truth odometry from Isaac Sim substitutes VSLAM on desktop.
RUN apt-get update && apt-get install -y \
    libgoogle-glog-dev \
    libgflags-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/isaac_ros_ws/src && \
    cd /opt/isaac_ros_ws/src && \
    git clone --recurse-submodules -b release-3.2 \
        https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_common.git && \
    git clone --recurse-submodules -b release-3.2 \
        https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_nvblox.git && \
    cd /opt/isaac_ros_ws && \
    source /opt/ros/humble/setup.bash && \
    rosdep install --from-paths src --ignore-src -r -y \
        --skip-keys "libopencv-dev python3-opencv libopencv-contrib-dev" && \
    colcon build \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
        2>&1 | tee /tmp/nvblox_build.log && \
    rm -rf /opt/isaac_ros_ws/build /opt/isaac_ros_ws/log

# Python dependencies for robot workspace
RUN pip3 install --no-cache-dir \
    numpy \
    websockets

# rosdep
RUN rosdep init || true
RUN rosdep update || true

# Workspace mount point
RUN mkdir -p /workspaces/teambowl_ws/src

# Auto-source in interactive shells
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc && \
    echo "if [ -f /opt/isaac_ros_ws/install/setup.bash ]; then source /opt/isaac_ros_ws/install/setup.bash; fi" >> /root/.bashrc && \
    echo "if [ -f /workspaces/teambowl_ws/install/setup.bash ]; then source /workspaces/teambowl_ws/install/setup.bash; fi" >> /root/.bashrc

COPY docker/entrypoint_isaac_sim.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /workspaces/teambowl_ws
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
